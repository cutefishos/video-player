# Writes a C++ source listing each SVG by its name without the suffix:
#   cmake -DOUTPUT=icons.cpp -DFILES="a.svg|b.svg" -P EmbedIcons.cmake
string(REPLACE "|" ";" FILES "${FILES}")
set(arrays "")
set(entries "")
set(index 0)
foreach(file ${FILES})
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(name ${file} NAME_WE)
    string(APPEND arrays "static const char kIcon${index}[] = {${bytes}};\n")
    string(APPEND entries "        {\"${name}\", std::string_view(kIcon${index}, sizeof(kIcon${index}))},\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE ${OUTPUT} "// Generated by EmbedIcons.cmake.
#include \"icons.h\"

${arrays}
const std::vector<std::pair<std::string_view, std::string_view>>& embeddedIcons()
{
    static const std::vector<std::pair<std::string_view, std::string_view>> icons {
${entries}    };
    return icons;
}
")
